---
import { cevirmen, type Dil } from '../i18n';
import { MAGAZA } from '../config';

interface Props {
  dil: Dil;
}
const { dil } = Astro.props;
const t = cevirmen(dil);
const rozetler = [
  { ad: t('magaza.play'), ust: 'Google Play', href: MAGAZA.play, simge: '▶' },
  { ad: t('magaza.appStore'), ust: 'App Store', href: MAGAZA.appStore, simge: '' },
];
---

<div class="flex flex-wrap gap-3">
  {
    rozetler.map((r) =>
      r.href ? (
        <a href={r.href} rel="noopener" class="inline-flex items-center gap-3 rounded-kart bg-emerald-900 text-white px-4 py-2.5 no-underline hover:bg-black">
          <span aria-hidden="true" class="text-xl">{r.simge}</span>
          <span class="text-sm font-medium">{r.ad}</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-3 rounded-kart border border-white/30 bg-emerald-900/60 text-white/80 px-4 py-2.5">
          <span aria-hidden="true" class="text-xl">{r.simge}</span>
          <span class="text-sm">
            {r.ust} · {t('magaza.yakinda')}
          </span>
        </span>
      ),
    )
  }
</div>
