---
import { cevirmen, yol, type Dil } from '../i18n';
import { SIRKET } from '../config';

interface Props {
  dil: Dil;
}
const { dil } = Astro.props;
const t = cevirmen(dil);
const yasal = [
  { ad: t('altbilgi.gizlilik'), href: yol(dil, '/yasal/gizlilik') },
  { ad: t('altbilgi.kvkk'), href: yol(dil, '/yasal/kvkk') },
  { ad: t('altbilgi.acikRiza'), href: yol(dil, '/yasal/acik-riza') },
  { ad: t('altbilgi.kosullar'), href: yol(dil, '/yasal/kullanim-kosullari') },
];
const diger = [
  { ad: t('altbilgi.destek'), href: yol(dil, '/destek') },
  { ad: t('altbilgi.hesapSilme'), href: yol(dil, '/hesap-silme') },
];
const yil = new Date().getFullYear();
---

<footer class="bg-emerald-800 text-white/85 mt-16">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 font-bold text-white text-lg">
        <img src="/logo.png" alt="" width="36" height="34" class="h-8 w-auto rounded-md bg-white/95 p-0.5" />
        {t('site.ad')}
      </div>
      <p class="mt-3 text-sm leading-relaxed">
        {SIRKET.unvan}<br />
        {SIRKET.adres}<br />
        MERSİS: {SIRKET.mersis}
      </p>
    </div>
    <nav aria-label={t('altbilgi.yasal')}>
      <h2 class="font-semibold text-white mb-3">{t('altbilgi.yasal')}</h2>
      <ul class="space-y-2 text-sm">
        {yasal.map((l) => <li><a href={l.href} class="hover:text-white">{l.ad}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={t('altbilgi.destek')}>
      <h2 class="font-semibold text-white mb-3">{t('altbilgi.destek')}</h2>
      <ul class="space-y-2 text-sm">
        {diger.map((l) => <li><a href={l.href} class="hover:text-white">{l.ad}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-5 text-xs text-white/70 space-y-2">
      <p class="rounded-kart bg-white/5 px-3 py-2">{t('altbilgi.fetva')}</p>
      <p>© {yil} {t('site.ad')}. {t('altbilgi.haklar')}</p>
    </div>
  </div>
</footer>
