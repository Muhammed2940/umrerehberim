---
// Giriş bölümünün sol kenarı: geometrik yıldız deseni ve onu sınırlayan ince altın kemer çizgisi.
// Süs öğesidir (aria-hidden). RTL'de aynalanır (yalnız geometri; yazı içermez).
---

<svg
  class="desen-solma pointer-events-none absolute inset-y-0 start-0 hidden h-full w-[300px] sm:block rtl:-scale-x-100"
  viewBox="0 0 300 560"
  preserveAspectRatio="xMinYMax slice"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <pattern id="gk-yildiz" width="30" height="30" patternUnits="userSpaceOnUse">
      <g stroke="#3f9474" stroke-opacity="0.38" stroke-width="0.9" transform="translate(-7 -7)">
        <rect x="13" y="13" width="18" height="18"></rect>
        <rect x="13" y="13" width="18" height="18" transform="rotate(45 22 22)"></rect>
        <path d="M7 22h6M31 22h6M22 7v6M22 31v6"></path>
      </g>
    </pattern>
    <!-- Kemerin dışında kalan bölge -->
    <clipPath id="gk-dis">
      <path d="M0 0H232C222 14 212 30 192 42 140 72 64 120 62 240V560H0Z"></path>
    </clipPath>
  </defs>
  <rect width="300" height="560" fill="url(#gk-yildiz)" clip-path="url(#gk-dis)"></rect>
  <!-- Altın kemer çizgisi -->
  <path
    d="M62 560V240C64 120 140 72 192 42 212 30 222 14 232 0"
    stroke="#c9a24a"
    stroke-width="2"
    stroke-linecap="round"
  ></path>
  <path d="M232 0c6 12 18 20 34 22" stroke="#c9a24a" stroke-width="2" stroke-linecap="round"></path>
</svg>
