---
// Aile Takibi izleyicisi: https://ALAN/t/#<token>  (demo: /t/#demo)
// Sözleşme: umrerehberim/docs/plan/AILE_TAKIBI_SOZLESME.md ("Web sayfası /t/").
// Kendi kabuğu var (üst şerit + tam ekran harita); Base.astro'nun üst/alt bilgisi kullanılmaz.
// noindex + referrer no-referrer; token yalnız location.hash'te, API'ye POST gövdesiyle gider.
import '../../styles/global.css';
import Logo from '../../components/Logo.astro';
import Ikon from '../../components/Ikon.astro';
import { DILLER, DIL_ADI, YON, cevirmen, dilYollari, yol, type Dil } from '../../i18n';
import { sayfaMetni } from '../../i18n/sayfa';
import { TAKIP } from '../../i18n/sayfa/takip';
import { API_URL, SITE_URL } from '../../config';

export const getStaticPaths = dilYollari;
const { dil } = Astro.props as { dil: Dil };
const t = cevirmen(dil);
const T = sayfaMetni(dil, TAKIP);
const metin = Object.fromEntries(Object.keys(TAKIP.tr).map((k) => [k, T[k as keyof typeof TAKIP.tr]]));
const ayar = JSON.stringify({ api: API_URL, dil, metin }).replace(/</g, '\\u003c');
const baslik = `${T.baslik} | ${t('site.ad')}`;
---

<!doctype html>
<html lang={dil} dir={YON[dil]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{baslik}</title>
    <meta name="description" content={T.aciklama} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#235347" />
    <link rel="icon" type="image/png" href="/og.png" />
    <link rel="apple-touch-icon" href="/og.png" />
  </head>
  <body class="flex h-dvh flex-col overflow-hidden bg-zemin text-metin antialiased">
    <header class="yesil-degrade z-[1200] flex shrink-0 items-center gap-3 px-4 py-2.5 text-white">
      <a href={SITE_URL + yol(dil, '/')} class="flex min-w-0 items-center gap-2.5 no-underline" aria-label={T.anaSayfa} rel="noopener">
        <Logo boyut={30} koyu />
        <span class="baslik truncate text-[17px] font-bold leading-tight">{T.baslik}</span>
      </a>
      <span
        data-r="demo-rozet"
        hidden
        class="rounded-full bg-altin px-2.5 py-0.5 text-[12px] font-semibold whitespace-nowrap text-emerald-900"
      >
        {T.demoRozet}
      </span>
      <nav class="ms-auto flex items-center gap-1 text-[13px]" aria-label="Language">
        {
          DILLER.map((d) => (
            <a
              href={yol(d, '/t/')}
              data-dil-link
              hreflang={d}
              aria-label={DIL_ADI[d]}
              lang={d}
              aria-current={d === dil ? 'true' : undefined}
              class:list={[
                'inline-flex min-h-8 min-w-8 items-center justify-center rounded-full px-2 no-underline',
                d === dil ? 'bg-mint font-bold text-emerald-800' : 'text-koyu-soluk hover:bg-white/10',
              ]}
            >
              <span class="sm:hidden" aria-hidden="true">{d.toUpperCase()}</span>
              <span class="hidden sm:inline">{DIL_ADI[d]}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <div class="relative min-h-0 flex-1">
      <div data-r="harita" class="absolute inset-0 bg-[#dfe9e2]" role="region" aria-label={T.baslik}></div>

      <!-- Bilgi kartı -->
      <section
        data-r="kart"
        hidden
        aria-live="polite"
        class="takip-kart absolute inset-x-3 bottom-3 z-[1000] mx-auto max-w-lg rounded-[20px] border border-cizgi bg-white p-4 shadow-[0_10px_30px_-8px_rgb(5_31_32/0.35)]"
      >
        <div class="flex items-center gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mint text-emerald-600" aria-hidden="true">
            <Ikon ad="kisiKonum" boyut={26} />
          </span>
          <div class="min-w-0 flex-1">
            <h1 data-r="ad" class="baslik truncate text-[20px] font-bold leading-tight text-emerald-800"></h1>
            <p data-r="yer" hidden class="mt-0.5 text-[15px] font-medium text-emerald-600"></p>
          </div>
          <span
            data-r="ag-rozet"
            hidden
            class="inline-flex shrink-0 items-center gap-1 rounded-full bg-[#fbeed6] px-2.5 py-1 text-[12px] font-semibold text-uyari"
          >
            <Ikon ad="bilgi" boyut={14} />
            {T.baglantiYok}
          </span>
        </div>

        <p data-r="guncel-satir" hidden class="mt-3 flex items-center gap-2 text-[14px] text-soluk">
          <Ikon ad="saat" boyut={16} class="shrink-0" />
          <span data-r="guncel"></span>
        </p>

        <div data-r="uyarilar" class="mt-3 space-y-2"></div>

        <div class="mt-3 flex items-center gap-2">
          <button type="button" data-r="yenile" class="dugme-acik min-h-11 flex-1 !py-2 text-[15px]">
            <Ikon ad="saat" boyut={18} />
            {T.yenile}
          </button>
          <button type="button" data-r="konuma" hidden class="dugme-ana min-h-11 flex-1 !py-2 text-[15px]">
            <Ikon ad="konum" boyut={18} />
            {T.konumaDon}
          </button>
        </div>
        <p class="mt-3 text-center text-[12px] text-soluk">{T.gizlilik}</p>
      </section>

      <!-- Yükleniyor / hata paneli (harita üstünde tam kaplar) -->
      <section data-r="panel" class="absolute inset-0 z-[1100] flex items-center justify-center bg-zemin p-5">
        <div data-r="panel-yukleniyor" class="text-center">
          <span class="takip-donen mx-auto block h-11 w-11 rounded-full border-4 border-mint border-t-emerald-600" aria-hidden="true"></span>
          <p class="mt-4 text-[16px] text-soluk" role="status">{T.yukleniyor}</p>
        </div>
        <div data-r="panel-hata" hidden class="w-full max-w-md rounded-[20px] border border-cizgi bg-white p-6 text-center shadow-sm">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-mint text-emerald-600" aria-hidden="true">
            <Ikon ad="konum" boyut={28} />
          </span>
          <h1 data-r="panel-baslik" class="baslik mt-4 text-[22px] font-bold text-emerald-800" role="alert"></h1>
          <p data-r="panel-metin" class="mt-2 text-[16px] leading-relaxed text-emerald-900/85"></p>
          <a href={SITE_URL + yol(dil, '/')} class="dugme-acik mt-6 min-h-11 text-[15px] no-underline" rel="noopener">{T.anaSayfa}</a>
        </div>
      </section>
    </div>

    <script id="takip-ayar" type="application/json" set:html={ayar} />
    <noscript>
      <p class="p-4 text-center">JavaScript required.</p>
    </noscript>
  </body>
</html>

<script>
  import '../../lib/takip';
</script>

<style is:global>
  html,
  body {
    overscroll-behavior: none;
  }
  .takip-kart {
    margin-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  .takip-not {
    border-radius: 12px;
    background: var(--color-zemin);
    padding: 0.6rem 0.8rem;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-emerald-700);
  }
  .takip-not-uyari {
    background: #fbeed6;
    color: #7a4d0b;
  }
  /* Leaflet işaretçisi: stil yalnız sınıflarla (CSP style-src 'self'). */
  .takip-isaret {
    background: none;
    border: 0;
  }
  .takip-isaret-nokta {
    position: relative;
    display: block;
    width: 28px;
    height: 28px;
    box-sizing: border-box;
    border: 4px solid #fff;
    border-radius: 9999px;
    background: var(--color-emerald-600);
    box-shadow: 0 2px 8px rgb(5 31 32 / 0.45);
  }
  .takip-isaret-nokta::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 9999px;
    border: 2px solid var(--color-emerald-600);
    opacity: 0;
    animation: takip-nabiz 2s ease-out infinite;
  }
  @keyframes takip-nabiz {
    0% {
      transform: scale(0.8);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .takip-donen {
    animation: takip-don 0.9s linear infinite;
  }
  @keyframes takip-don {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .takip-isaret-nokta::after,
    .takip-donen {
      animation: none;
    }
  }
  .leaflet-container {
    font-family: inherit;
  }
  .leaflet-control-attribution {
    font-size: 11px;
  }
</style>
