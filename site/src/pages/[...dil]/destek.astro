---
import Base from '../../layouts/Base.astro';
import { cevirmen, dilYollari, yol, type Dil } from '../../i18n';
import { destekBilgisi, telHref, waHref } from '../../lib/destek';

export const getStaticPaths = dilYollari;
const { dil } = Astro.props as { dil: Dil };
const t = cevirmen(dil);
const d = await destekBilgisi();

const telefonlar = [d.telefon1, d.telefon2].filter(Boolean);
const epostalar = [d.eposta1, d.eposta2].filter(Boolean);
---

<Base dil={dil} yalin="/destek/" baslik={t('destek.baslik')}>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-emerald-700">{t('destek.baslik')}</h1>
    <p class="mt-3 text-soluk">{t('destek.giris')}</p>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <section class="kart p-6">
        <h2 class="font-semibold text-emerald-700">📞 {t('destek.telefon')}</h2>
        <ul class="mt-3 space-y-1">
          {telefonlar.length
            ? telefonlar.map((n) => <li><a href={telHref(n)} dir="ltr" class="text-emerald-600 underline">{n}</a></li>)
            : <li class="text-soluk text-sm">{t('destek.bilgiYok')}</li>}
        </ul>
      </section>
      <section class="kart p-6">
        <h2 class="font-semibold text-emerald-700">💬 {t('destek.whatsapp')}</h2>
        <div class="mt-3">
          {d.whatsapp
            ? <a href={waHref(d.whatsapp)} rel="noopener" class="dugme-ana !py-2 text-sm">{t('destek.whatsappYaz')}</a>
            : <span class="text-soluk text-sm">{t('destek.bilgiYok')}</span>}
        </div>
      </section>
      <section class="kart p-6">
        <h2 class="font-semibold text-emerald-700">✉️ {t('destek.eposta')}</h2>
        <ul class="mt-3 space-y-1 break-all">
          {epostalar.length
            ? epostalar.map((e) => <li><a href={`mailto:${e}`} dir="ltr" class="text-emerald-600 underline">{e}</a></li>)
            : <li class="text-soluk text-sm">{t('destek.bilgiYok')}</li>}
        </ul>
      </section>
    </div>

    <section class="kart mt-8 p-6 bg-mint/40">
      <h2 class="font-semibold text-emerald-700">{t('destek.ipucuBaslik')}</h2>
      <ul class="mt-3 list-disc ps-6 space-y-2 text-sm">
        <li>{t('destek.ipucu1')}</li>
        <li>{t('destek.ipucu2')}</li>
        <li><a href={yol(dil, '/hesap-silme/')} class="text-emerald-600 underline">{t('destek.ipucu3')}</a></li>
      </ul>
    </section>
  </div>
</Base>
