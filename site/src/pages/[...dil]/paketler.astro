---
// Paketler: onaylı referans görsel (04-paketler) düzeni.
// Paket adı, fiyat, süre/kişi ve madde listeleri uygulamanın paketler.json dosyasından (tek kaynak, paket()).
// Görselden yalnız yerleşim, kart altı kısa açıklamalar ve düğme metinleri alınır (i18n/sayfa/paketler.ts).
import Base from '../../layouts/Base.astro';
import Ikon from '../../components/Ikon.astro';
import EkIkon from '../../components/paketler/EkIkon.astro';
import { dilYollari, paket, paketFiyat, yol, type Dil } from '../../i18n';
import KurGuncelle from '../../components/KurGuncelle.astro';
import { sayfaMetni } from '../../i18n/sayfa';
import { PAKETLER } from '../../i18n/sayfa/paketler';
import { MAGAZA } from '../../config';

export const getStaticPaths = dilYollari;
const { dil } = Astro.props as { dil: Dil };
const T = sayfaMetni(dil, PAKETLER);
const p = (k: Parameters<typeof paket>[1]) => paket(dil, k);

// Mağaza durumu: tek mağaza bağlantısı varsa oraya; ikisi de varsa veya hiçbiri yoksa ana sayfadaki indirme alanına.
const magazalar = [MAGAZA.play, MAGAZA.appStore].filter(Boolean);
const indirHref = magazalar.length === 1 ? magazalar[0] : yol(dil, '/#indir');
const disBaglanti = magazalar.length === 1;

const ucretsiz = [p('paketlerFreeF1'), p('paketlerFreeF2'), p('paketlerFreeF3'), p('paketlerFreeF4')];
const umre = [p('paketlerUmreF1'), p('paketlerUmreF2'), p('paketlerUmreF3'), p('paketlerUmreF4'), p('paketlerUmreF5')];
const aile = [p('paketlerAileF1'), p('paketlerAileF2'), p('paketlerAileF3')];

const kartlar = [
  {
    ad: p('paketlerFreeName'),
    alt: T.ucretsizAlt,
    fiyat: p('paketlerFreePrice'),
    fiyatOz: paketFiyat(dil, 'paketlerFreePrice').oznitelik,
    sure: '',
    rozet: '',
    maddeler: ucretsiz,
    dugme: T.ucretsizBasla,
    tur: 'ucretsiz' as const,
  },
  {
    ad: p('paketlerUmreName'),
    alt: T.umreAlt,
    fiyat: p('paketlerUmrePrice'),
    fiyatOz: paketFiyat(dil, 'paketlerUmrePrice').oznitelik,
    sure: p('paketlerUmrePeriod'),
    rozet: p('paketlerRecommended'),
    maddeler: umre,
    dugme: T.paketiSec,
    tur: 'umre' as const,
  },
  {
    ad: p('paketlerAileName'),
    alt: T.aileAlt,
    fiyat: p('paketlerAilePrice'),
    fiyatOz: paketFiyat(dil, 'paketlerAilePrice').oznitelik,
    sure: p('paketlerAilePeriod'),
    rozet: p('paketlerBestValue'),
    maddeler: aile,
    dugme: T.paketiSec,
    tur: 'aile' as const,
  },
];

// Full Umre dahil hizmetleri (paketler.json F1–F7) ve ikonları
const fullMaddeler = [
  { metin: p('paketlerFullF1'), ikon: 'ucak' },
  { metin: p('paketlerFullF2'), ikon: 'belge' },
  { metin: p('paketlerFullF3'), ikon: 'yatak' },
  { metin: p('paketlerFullF4'), ek: 'yemek' },
  { metin: p('paketlerFullF5'), ikon: 'otobus' },
  { metin: p('paketlerFullF6'), ek: 'sim' },
  { metin: p('paketlerFullF7'), ek: 'akilliTelefon' },
] as const;

// Karşılaştırma tablosu: [ücretsiz, umre, aile, full umre]
// Full Umre (paketler.json F7) Umre Paketi'nin tüm uygulama özelliklerini içerir; Aile'nin grup
// özellikleri (6 kişi, grup haritası, telsiz) kişi başı satılan Full pakette yok.
type Hucre = boolean | string;
type Satir = [Hucre, Hucre, Hucre, Hucre];
const sutunlar = [...kartlar.map((k) => ({ ad: k.ad, tur: k.tur as string })), { ad: p('paketlerFullName'), tur: 'full' }];
const fiyatOz = (['Free', 'Umre', 'Aile', 'Full'] as const).map((k) => paketFiyat(dil, `paketler${k}Price`).oznitelik);
const satirlar: { ad: string; d: Satir; oz?: Record<string, string>[] }[] = [
  { ad: T.fiyat, d: [p('paketlerFreePrice'), p('paketlerUmrePrice'), p('paketlerAilePrice'), p('paketlerFullPrice')], oz: fiyatOz },
  { ad: T.sureKisi, d: [p('paketlerFreeBadge'), p('paketlerUmrePeriod'), p('paketlerAilePeriod'), p('paketlerFullPeriod')] },
  ...ucretsiz.map((ad) => ({ ad, d: [true, true, true, true] as Satir })),
  ...umre.map((ad) => ({ ad, d: [false, true, true, true] as Satir })),
  ...aile.slice(1).map((ad) => ({ ad, d: [false, false, true, false] as Satir })),
  ...fullMaddeler.slice(0, 6).map((m) => ({ ad: m.metin, d: [false, false, false, true] as Satir })),
];
---

<Base dil={dil} yalin="/paketler/" baslik={T.baslik} aciklama={T.aciklama}>
  <div class="paket-zemin">
    <!-- 1. Başlık -->
    <section class="mx-auto max-w-5xl px-4 pt-12 pb-8 text-center md:pt-14">
      <div class="flex items-center justify-center gap-6">
        <span class="hidden h-px w-[130px] bg-altin/80 sm:block" aria-hidden="true"></span>
        <h1 class="text-[2.25rem] font-bold leading-tight text-emerald-900 sm:text-5xl lg:text-[52px]">{T.baslik}</h1>
        <span class="hidden h-px w-[130px] bg-altin/80 sm:block" aria-hidden="true"></span>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-emerald-900/85 sm:text-[19px] text-pretty">{T.alt}</p>
    </section>

    <!-- 2. Telefon maketi + üç dijital kart -->
    <section class="mx-auto w-full max-w-[1536px] px-4 md:px-6 xl:ps-0">
      <div class="grid items-center gap-6 xl:grid-cols-[318px_minmax(0,1fr)]">
        <img
          src="/img/paketler/telefon.webp"
          alt={T.telefonGorsel}
          width="318"
          height="460"
          class="telefon-solma hidden xl:block"
        />
        <div class="mx-auto grid w-full max-w-xl gap-6 pt-3 lg:max-w-none lg:grid-cols-3 lg:gap-5">
          {
            kartlar.map((k) => {
              const vurgu = k.tur === 'umre';
              return (
                <article
                  class:list={[
                    'relative flex flex-col rounded-2xl p-6 sm:p-7',
                    vurgu
                      ? 'umre-kart border-2 border-altin text-white shadow-[0_14px_34px_-14px_rgb(5_31_32/0.6)]'
                      : 'border border-krem-cizgi bg-[#fbfaf6] text-emerald-900 shadow-[0_2px_10px_rgb(60_50_20/0.05)]',
                  ]}
                >
                  {k.rozet && (
                    <span
                      class:list={[
                        'absolute -top-3.5 end-5 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium',
                        vurgu ? 'bg-[#f1dfa6] text-emerald-900 shadow-sm' : 'border border-krem-cizgi bg-[#eef4ec] text-emerald-700',
                      ]}
                    >
                      {vurgu && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" />
                        </svg>
                      )}
                      {k.rozet}
                    </span>
                  )}
                  <div class="flex items-start gap-4">
                    <span
                      class:list={[
                        'flex h-[76px] w-[76px] shrink-0 items-center justify-center rounded-full',
                        vurgu ? 'altin-daire text-emerald-800' : 'bg-[#e2eedf] text-emerald-600',
                      ]}
                    >
                      {k.tur === 'ucretsiz' && <EkIkon ad="akilliTelefon" boyut={38} />}
                      {k.tur === 'umre' && <Ikon ad="kabe" boyut={38} />}
                      {k.tur === 'aile' && <Ikon ad="aile" boyut={38} />}
                    </span>
                    <div class="min-w-0 pt-1">
                      <h2 class="text-[1.6rem] font-bold leading-tight lg:text-[28px]">{k.ad}</h2>
                      <p class:list={['mt-1.5 leading-snug', vurgu ? 'text-white/85' : 'text-emerald-900/80']}>{k.alt}</p>
                    </div>
                  </div>
                  <p class:list={['baslik mt-5 text-[2.5rem] font-bold leading-none', vurgu ? 'text-[#f1dfa6]' : 'text-emerald-900']}>
                    <bdi {...k.fiyatOz}>{k.fiyat}</bdi>
                  </p>
                  {k.sure && <p class:list={['mt-2 text-[15px]', vurgu ? 'text-white/80' : 'text-soluk']}>{k.sure}</p>}
                  <ul class="mt-5 space-y-2.5">
                    {k.maddeler.map((m) => (
                      <li class="flex gap-3 leading-snug">
                        <span class:list={['mt-0.5 shrink-0', vurgu ? 'text-[#f1dfa6]' : 'text-emerald-600']}>
                          <Ikon ad="tik" boyut={20} />
                        </span>
                        <span>{m}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-auto pt-6">
                  <a
                    href={indirHref}
                    rel={disBaglanti ? 'noopener' : undefined}
                    class:list={[
                      'flex min-h-[50px] items-center justify-center rounded-xl px-5 text-lg font-semibold no-underline transition',
                      vurgu
                        ? 'dugme-altin'
                        : 'border-[1.5px] border-emerald-600 bg-white text-emerald-900 hover:bg-emerald-600 hover:text-white',
                    ]}
                  >
                    <span class="baslik">{k.dugme}</span>
                  </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>

      <!-- Onaylı koşullar: acente avantajı ve otomatik yenileme (paketler.json) -->
      <div class="mt-5 flex flex-col gap-2 text-[15px] text-emerald-900/80 xl:ms-[342px]">
        <p class="flex gap-2"><span class="mt-0.5 shrink-0 text-emerald-600"><Ikon ad="grupCanta" boyut={20} /></span>{p('paketlerAgencyNote')}</p>
        <p class="flex gap-2"><span class="mt-0.5 shrink-0 text-emerald-600"><Ikon ad="bilgi" boyut={20} /></span>{p('paketlerFootnote')}</p>
        {p('paketlerKurNot') && <p class="flex gap-2"><span class="mt-0.5 shrink-0 text-emerald-600"><Ikon ad="bilgi" boyut={20} /></span>{p('paketlerKurNot')}</p>}
      </div>
    </section>

    <!-- 3. Full Umre seyahat paneli -->
    <section class="mx-auto w-full max-w-[1536px] px-4 pt-10 md:px-6" aria-labelledby="full-umre-baslik">
      <div class="full-panel relative overflow-hidden rounded-2xl border border-krem-cizgi bg-[#fbfaf6] shadow-[0_2px_10px_rgb(60_50_20/0.05)]">
        <!-- Görsel: mobilde üstte, geniş ekranda sağda (Kâbe aynalanmaz) -->
        <div class="relative h-56 sm:h-72 xl:absolute xl:inset-y-0 xl:end-0 xl:h-auto xl:w-[40%]">
          <img
            src="/img/paketler/kabe-panel.webp"
            alt=""
            width="570"
            height="320"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          <span class="panel-solma pointer-events-none absolute inset-0 hidden xl:block" aria-hidden="true"></span>
        </div>

        <div class="relative grid gap-8 p-6 sm:p-10 xl:w-[72%] xl:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] xl:gap-0 xl:py-9 xl:ps-12 xl:pe-0">
          <div class="xl:border-e xl:border-krem-cizgi xl:pe-10">
            <p class="inline-flex items-center gap-2 rounded-full border border-altin/60 bg-[#fbf3df] px-4 py-1 text-emerald-900">
              <Ikon ad="ucak" boyut={20} />
              {T.seyahatPaketi}
            </p>
            <h2 id="full-umre-baslik" class="mt-3 text-[2.4rem] font-bold leading-tight text-emerald-900 lg:text-[50px]">{p('paketlerFullName')}</h2>
            <p class="mt-2 text-lg leading-snug text-emerald-900/85">{T.fullAlt}</p>
            <p class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="baslik text-[3rem] font-bold leading-none text-emerald-900 lg:text-[58px]"><bdi>{p('paketlerFullPrice')}</bdi></span>
              <span class="text-xl text-altin-koyu">/ {p('paketlerFullPeriod')}</span>
            </p>
            <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center">
              <a href={yol(dil, '/full-umre/')} class="giris-zemin inline-flex min-h-[52px] items-center justify-center gap-3 rounded-xl px-12 text-xl font-semibold text-white no-underline shadow-md transition hover:brightness-125">
                <span class="baslik">{T.basvur}</span>
                <Ikon ad="ok" boyut={24} />
              </a>
              <p class="flex items-center gap-3 text-emerald-900/85 sm:border-s sm:border-krem-cizgi sm:ps-6">
                <span class="shrink-0 text-altin"><Ikon ad="takvimTik" boyut={28} /></span>
                {T.basvurNot}
              </p>
            </div>
          </div>
          <div class="xl:ps-12">
            <h3 class="sr-only">{T.dahilHizmetler}</h3>
            <ul class="space-y-3.5">
              {
                fullMaddeler.map((m) => (
                  <li class="flex items-center gap-4 text-emerald-900">
                    <span class="shrink-0 text-emerald-600">
                      {'ikon' in m ? <Ikon ad={m.ikon} boyut={26} /> : <EkIkon ad={m.ek} boyut={26} />}
                    </span>
                    <span class="leading-snug">{m.metin}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Karşılaştırma tablosu (paketler.json maddelerinden) -->
    <section class="mx-auto w-full max-w-[1200px] px-4 pt-14 pb-16 md:px-6" aria-labelledby="karsilastir-baslik">
      <h2 id="karsilastir-baslik" class="text-center text-3xl font-bold text-emerald-900 md:text-4xl">{T.karsilastirBaslik}</h2>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-krem-cizgi bg-[#fbfaf6]">
        <table class="w-full min-w-[760px] border-collapse text-start">
          <caption class="sr-only">{T.karsilastirBaslik}</caption>
          <thead>
            <tr class="border-b border-krem-cizgi">
              <th scope="col" class="px-5 py-4 text-start font-semibold text-emerald-900">{T.ozellik}</th>
              {sutunlar.map((k) => (
                <th
                  scope="col"
                  class:list={[
                    'px-4 py-4 text-center font-semibold',
                    k.tur === 'umre' ? 'bg-emerald-600 text-white' : k.tur === 'full' ? 'bg-[#fbf3df] text-emerald-900' : 'text-emerald-900',
                  ]}
                >
                  {k.ad}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              satirlar.map((s) => (
                <tr class="border-b border-krem-cizgi last:border-b-0">
                  <th scope="row" class="px-5 py-3 text-start font-normal text-emerald-900">{s.ad}</th>
                  {s.d.map((h, i) => (
                    <td class:list={['px-4 py-3 text-center', i === 1 && 'bg-[#eef4ec]', i === 3 && 'bg-[#fdf8ec]']}>
                      {typeof h === 'string' ? (
                        <bdi class="text-[15px] font-medium text-emerald-900" {...s.oz?.[i]}>{h}</bdi>
                      ) : h ? (
                        <span class="inline-flex text-emerald-600">
                          <Ikon ad="tik" boyut={22} />
                          <span class="sr-only">{T.var}</span>
                        </span>
                      ) : (
                        <span class="text-emerald-900/40">
                          <span aria-hidden="true">—</span>
                          <span class="sr-only">{T.yok}</span>
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
  <KurGuncelle />
</Base>

<style>
  .paket-zemin {
    background: linear-gradient(180deg, #f8f2e7 0%, #f6f3ec 40%, #f6f3ec 100%);
  }
  .telefon-solma {
    mask-image: radial-gradient(ellipse 85% 75% at 55% 50%, #000 62%, transparent 100%);
  }
  .umre-kart {
    background:
      radial-gradient(ellipse 70% 50% at 30% 0%, rgb(35 83 71 / 0.6), transparent 70%),
      linear-gradient(160deg, #0d4535 0%, #0b2b26 100%);
  }
  .altin-daire {
    background: radial-gradient(circle at 35% 30%, #f6dc93, #c9a24a 75%);
    box-shadow: 0 0 0 3px rgb(241 223 166 / 0.35);
  }
  /* Görselin panel zeminine yumuşak geçişi; RTL'de yön değişir. */
  .panel-solma {
    background: linear-gradient(90deg, #fbfaf6 0%, rgb(251 250 246 / 0.6) 22%, transparent 50%);
  }
  :global(html[dir='rtl']) .panel-solma {
    background: linear-gradient(270deg, #fbfaf6 0%, rgb(251 250 246 / 0.6) 22%, transparent 50%);
  }
</style>
