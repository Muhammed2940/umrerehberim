---
// Apache: ErrorDocument 404 /404.html (.htaccess). Tek dosya; TR metin + EN/AR kısa notlar.
import Base from '../layouts/Base.astro';
import { cevirmen } from '../i18n';
const t = cevirmen('tr');
const en = cevirmen('en');
const ar = cevirmen('ar');
---

<Base dil="tr" yalin="/404/" baslik={t('bulunamadi.baslik')} noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-sage">404</p>
    <h1 class="mt-4 text-2xl font-bold text-emerald-700">{t('bulunamadi.baslik')}</h1>
    <p class="mt-3 text-soluk">{t('bulunamadi.metin')}</p>
    <p class="mt-1 text-soluk text-sm" lang="en">{en('bulunamadi.baslik')}</p>
    <p class="mt-1 text-soluk text-sm" lang="ar" dir="rtl">{ar('bulunamadi.baslik')}</p>
    <a href="/" class="dugme-ana mt-8">{t('bulunamadi.don')}</a>
  </div>
</Base>
