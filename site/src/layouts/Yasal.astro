---
// Yasal metin düzeni (onaylı görsel 11-kvkk): üst bant (breadcrumb, başlık, kısa açıklama, Taslak rozeti),
// taslak durum şeridi, kenar içindekiler (masaüstü yapışkan; mobilde açılır dizin), veri sorumlusu kutusu
// (config.ts SIRKET), markdown gövdesi. Gövde metnine dokunulmaz (content/yasal/*.md).
import Base from './Base.astro';
import Ikon from '../components/Ikon.astro';
import { cevirmen, yol, type Dil } from '../i18n';
import { sayfaMetni } from '../i18n/sayfa';
import { YASAL } from '../i18n/sayfa/yasal';
import { SIRKET, YASAL_TARIH } from '../config';

type Belge = 'gizlilik' | 'kvkk' | 'acik-riza' | 'kullanim-kosullari';
interface Props {
  dil: Dil;
  yalin: string;
  baslik: string;
  /** Gövde dili (AR sayfası şimdilik EN metni gösterir) */
  govdeDili?: Dil;
  belge?: Belge;
  /** Markdown h2 başlıkları (içindekiler) */
  basliklar?: { slug: string; text: string }[];
}
const { dil, yalin, baslik, govdeDili = dil, belge, basliklar = [] } = Astro.props;
const t = cevirmen(dil);
const Y = sayfaMetni(dil, YASAL);
const dilNotu = t('yasal.dilNotu');
const tarih = new Intl.DateTimeFormat(dil === 'ar' ? 'ar' : dil, { dateStyle: 'long' }).format(new Date(YASAL_TARIH));
const govdeYon = govdeDili === 'ar' ? 'rtl' : 'ltr';

const BELGELER: { d: Belge; anahtar: string; aciklama: string }[] = [
  { d: 'kvkk', anahtar: 'yasal.kvkkBaslik', aciklama: Y.acikKvkk },
  { d: 'gizlilik', anahtar: 'yasal.gizlilikBaslik', aciklama: Y.acikGizlilik },
  { d: 'acik-riza', anahtar: 'yasal.acikRizaBaslik', aciklama: Y.acikAcikRiza },
  { d: 'kullanim-kosullari', anahtar: 'yasal.kosullarBaslik', aciklama: Y.acikKosullar },
];
const aciklama = BELGELER.find((b) => b.d === belge)?.aciklama;
const ilgili = BELGELER.filter((b) => b.d !== belge);

// İçindekiler: önce veri sorumlusu bölümü (şablonda), sonra belge başlıkları.
const VS_ID = 'veri-sorumlusu';
const dizin = [{ slug: VS_ID, text: t('yasal.veriSorumlusu'), sablon: true }, ...basliklar.map((b) => ({ ...b, sablon: false }))];
---

<Base dil={dil} yalin={yalin} baslik={baslik} aciklama={aciklama}>
  <!-- Üst bant -->
  <section class="yasal-bant relative overflow-hidden border-b border-krem-cizgi">
    <img
      src="/img/yasal/revak.webp"
      width="336"
      height="122"
      alt=""
      class="bant-gorsel pointer-events-none absolute start-0 top-0 hidden h-full w-auto max-w-none md:block"
    />
    <svg
      class="pointer-events-none absolute end-10 top-3 hidden h-[150px] w-auto text-sage/60 xl:block"
      viewBox="0 0 120 160"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      aria-hidden="true"
    >
      <path d="M8 160V70C8 38 34 20 60 4c26 16 52 34 52 66v90" />
      <path d="M20 160V74c0-24 20-40 40-54 20 14 40 30 40 54v86" />
      <path d="M60 36l10 12-10 12-10-12zM34 96h52M34 120h52M60 74v76" />
    </svg>
    <div class="relative mx-auto flex w-full max-w-[1200px] flex-col-reverse items-start justify-between gap-3 px-4 py-8 sm:flex-row sm:gap-6 md:ps-[300px] md:pe-6 lg:ps-[340px] xl:pe-44">
      <div class="min-w-0">
        <nav aria-label={Y.konum}>
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-emerald-900/80">
            <li><a href={yol(dil, '/')} class="inline-flex min-h-8 items-center font-medium hover:underline">{t('nav.anaSayfa')}</a></li>
            <li aria-hidden="true" class="yon-ok"><Ikon ad="sagOk" boyut={14} /></li>
            <li aria-current="page" class="text-altin-koyu">{baslik}</li>
          </ol>
        </nav>
        <h1 class="mt-2 text-3xl font-bold leading-tight text-emerald-800 sm:text-[40px]">{baslik}</h1>
        {aciklama && <p class="mt-3 max-w-[620px] text-[17px] leading-snug text-emerald-900/90">{aciklama}</p>}
        <span class="mt-4 block h-[3px] w-12 rounded-full bg-altin" aria-hidden="true"></span>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-lg sm:mt-8 border border-altin/50 bg-[#f6ecd2] px-3 py-1.5 text-sm font-semibold text-altin-koyu">
        <Ikon ad="belge" boyut={16} />
        {Y.taslakRozet}
      </span>
    </div>
  </section>

  <div class="bg-[#f7f9f5]">
    <div class="mx-auto w-full max-w-[1200px] px-4 py-8 md:px-6 lg:grid lg:grid-cols-[250px_1fr] lg:gap-12 lg:py-10">
      <!-- İçindekiler: mobilde açılır dizin -->
      <details class="dizin-mobil mb-6 rounded-xl border border-krem-cizgi bg-white lg:hidden">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between px-4 font-semibold text-emerald-800">
          {Y.icindekiler}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <ol class="border-t border-krem-cizgi px-2 py-2">
          {
            dizin.map((h) => (
              <li>
                <a href={`#${h.slug}`} data-dizin={h.slug} lang={h.sablon ? undefined : govdeDili} dir={h.sablon ? undefined : govdeYon} class="dizin-bag">
                  {h.text}
                </a>
              </li>
            ))
          }
        </ol>
      </details>

      <!-- İçindekiler: masaüstünde kenar menüsü -->
      <aside class="hidden lg:block lg:border-e lg:border-krem-cizgi lg:pe-6">
        <nav aria-labelledby="dizin-baslik" class="sticky top-24">
          <h2 id="dizin-baslik" class="text-xl font-bold text-emerald-800">{Y.icindekiler}</h2>
          <ol class="mt-3 space-y-0.5">
            {
              dizin.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-dizin={h.slug} lang={h.sablon ? undefined : govdeDili} dir={h.sablon ? undefined : govdeYon} class="dizin-bag">
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <div class="min-w-0 max-w-[760px]">
        <!-- Taslak durum şeridi -->
        <p class="flex items-start gap-3 rounded-xl border border-dashed border-uyari bg-amber-50 px-4 py-3 text-uyari" role="note">
          <Ikon ad="bilgi" boyut={22} class="mt-0.5 shrink-0" />
          <span>
            <strong class="font-bold tracking-wide">{t('yasal.taslak')}</strong>
            <span class="block text-[15px] text-metin/80">{t('yasal.taslakNot')}</span>
          </span>
        </p>
        <p class="mt-3 text-sm text-soluk">{t('yasal.sonGuncelleme')}: {tarih}</p>

        <section id={VS_ID} class="bolum mt-6 scroll-mt-24">
          <h2 class="yasal-h2">{t('yasal.veriSorumlusu')}</h2>
          <div class="mt-5 flex gap-4 rounded-xl bg-[#e3eedf] p-5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#9cb99f] text-emerald-900" aria-hidden="true">
              <Ikon ad="bilgi" boyut={20} />
            </span>
            <div class="min-w-0">
              <p class="font-bold text-emerald-900">{Y.bilgiler}</p>
              <dl class="mt-1.5 grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[16px] text-emerald-900">
                <dt class="mt-1 font-semibold sm:mt-0">{t('yasal.unvan')}:</dt><dd>{SIRKET.unvan}</dd>
                <dt class="mt-1 font-semibold sm:mt-0">{t('yasal.adres')}:</dt><dd>{SIRKET.adres}</dd>
                <dt class="mt-1 font-semibold sm:mt-0">{t('yasal.vergi')}:</dt><dd>{SIRKET.vergiDairesiNo}</dd>
                <dt class="mt-1 font-semibold sm:mt-0">{t('yasal.mersis')}:</dt><dd>{SIRKET.mersis}</dd>
                <dt class="mt-1 font-semibold sm:mt-0">{t('yasal.iletisim')}:</dt>
                <dd class="min-w-0 break-all">
                  <a class="font-medium text-emerald-700 underline underline-offset-2" href={`mailto:${SIRKET.kvkkEposta}`} dir="ltr">{SIRKET.kvkkEposta}</a>
                </dd>
              </dl>
            </div>
          </div>
        </section>

        {dilNotu && <p class="mt-6 rounded-xl bg-mint/60 px-4 py-3">{dilNotu}</p>}

        <article class="yazi yasal-govde mt-6" lang={govdeDili} dir={govdeYon}>
          <slot />
        </article>

        {
          belge && (
            <nav aria-labelledby="ilgili-baslik" class="mt-12 border-t border-krem-cizgi pt-6">
              <h2 id="ilgili-baslik" class="text-xl font-bold text-emerald-800">{Y.ilgili}</h2>
              <ul class="mt-3 flex flex-wrap gap-3">
                {ilgili.map((b) => (
                  <li>
                    <a href={yol(dil, `/yasal/${b.d}/`)} class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-krem-cizgi bg-white px-4 font-medium text-emerald-700 hover:border-emerald-600/50">
                      <Ikon ad="belge" boyut={18} />
                      {t(b.anahtar)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </div>
  </div>
</Base>

<script>
  // Etkin bölümü içindekilerde vurgula (JS yoksa düz liste kalır).
  const baglar = [...document.querySelectorAll<HTMLAnchorElement>('[data-dizin]')];
  const kimlikler = [...new Set(baglar.map((a) => a.dataset.dizin!))];
  const hedefler = kimlikler.map((k) => document.getElementById(k)).filter((e): e is HTMLElement => !!e);
  const isaretle = (k: string) => {
    for (const a of baglar) {
      const etkin = a.dataset.dizin === k;
      a.classList.toggle('etkin', etkin);
      if (etkin) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  if (hedefler.length && 'IntersectionObserver' in window) {
    const gorunen = new Set<string>();
    const g = new IntersectionObserver(
      (kayitlar) => {
        for (const k of kayitlar) {
          if (k.isIntersecting) gorunen.add(k.target.id);
          else gorunen.delete(k.target.id);
        }
        const ilk = kimlikler.find((k) => gorunen.has(k));
        if (ilk) isaretle(ilk);
      },
      { rootMargin: '-80px 0px -60% 0px' },
    );
    hedefler.forEach((h) => g.observe(h));
    isaretle(kimlikler[0]);
  }
  // Mobilde dizinden seçim yapılınca dizin kapansın.
  document.querySelector('.dizin-mobil')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) (e.currentTarget as HTMLDetailsElement).open = false;
  });
</script>

<style>
  .yasal-bant {
    background: linear-gradient(90deg, #eef4ec 0%, #e6efe3 55%, #edf3ea 100%);
  }
  .bant-gorsel {
    mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
  }
  :global(html[dir='rtl']) .bant-gorsel {
    mask-image: linear-gradient(270deg, #000 55%, transparent 100%);
  }
  .dizin-mobil summary::-webkit-details-marker {
    display: none;
  }
  .dizin-mobil[open] summary svg {
    transform: rotate(180deg);
  }
  .dizin-bag {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    border-inline-start: 3px solid transparent;
    color: var(--color-emerald-900);
    font-size: 16px;
    line-height: 1.35;
    text-decoration: none;
  }
  .dizin-bag:hover {
    background: rgb(218 241 222 / 0.6);
  }
  .dizin-bag.etkin {
    background: #dce9da;
    border-inline-start-color: var(--color-emerald-700);
    font-weight: 600;
    color: var(--color-emerald-800);
  }
  /* Başlıklar: görseldeki gibi altın alt çizgili */
  .yasal-h2,
  .yasal-govde :global(h2) {
    position: relative;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-emerald-800);
    scroll-margin-top: 6rem;
  }
  .yasal-h2 {
    margin-top: 0;
  }
  .yasal-h2::after,
  .yasal-govde :global(h2)::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    width: 48px;
    height: 3px;
    border-radius: 9999px;
    background: var(--color-altin);
  }
  /* Okuma odaklı gövde: 17–18px */
  .yasal-govde {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-emerald-900);
  }
  @media (min-width: 640px) {
    .yasal-govde {
      font-size: 18px;
    }
  }
</style>
