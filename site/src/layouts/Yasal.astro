---
// Yasal metin düzeni: taslak ibaresi, veri sorumlusu kutusu (config.ts'ten), markdown gövdesi.
import Base from './Base.astro';
import { cevirmen, type Dil } from '../i18n';
import { SIRKET, YASAL_TARIH } from '../config';

interface Props {
  dil: Dil;
  yalin: string;
  baslik: string;
  /** Gövde dili (AR sayfası şimdilik EN metni gösterir) */
  govdeDili?: Dil;
}
const { dil, yalin, baslik, govdeDili = dil } = Astro.props;
const t = cevirmen(dil);
const dilNotu = t('yasal.dilNotu');
const tarih = new Intl.DateTimeFormat(dil === 'ar' ? 'ar' : dil, { dateStyle: 'long' }).format(new Date(YASAL_TARIH));
---

<Base dil={dil} yalin={yalin} baslik={baslik}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <p
      class="rounded-kart border-2 border-dashed border-uyari bg-amber-50 px-4 py-3 text-uyari font-bold tracking-wide"
      role="note"
    >
      {t('yasal.taslak')}
      <span class="block font-normal text-sm text-metin/80 tracking-normal">{t('yasal.taslakNot')}</span>
    </p>

    <h1 class="mt-8 text-3xl font-bold text-emerald-700">{baslik}</h1>
    <p class="mt-2 text-sm text-soluk">{t('yasal.sonGuncelleme')}: {tarih}</p>

    <dl class="kart mt-6 p-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
      <dt class="col-span-2 font-semibold text-emerald-700 mb-1">{t('yasal.veriSorumlusu')}</dt>
      <dt class="text-soluk">{t('yasal.unvan')}</dt><dd>{SIRKET.unvan}</dd>
      <dt class="text-soluk">{t('yasal.adres')}</dt><dd>{SIRKET.adres}</dd>
      <dt class="text-soluk">{t('yasal.vergi')}</dt><dd>{SIRKET.vergiDairesiNo}</dd>
      <dt class="text-soluk">{t('yasal.mersis')}</dt><dd>{SIRKET.mersis}</dd>
      <dt class="text-soluk">{t('yasal.iletisim')}</dt>
      <dd><a class="text-emerald-600 underline" href={`mailto:${SIRKET.kvkkEposta}`} dir="ltr">{SIRKET.kvkkEposta}</a></dd>
    </dl>

    {dilNotu && <p class="mt-6 rounded-kart bg-mint/60 px-4 py-3 text-sm">{dilNotu}</p>}

    <article class="yazi mt-6" lang={govdeDili} dir={govdeDili === 'ar' ? 'rtl' : 'ltr'}>
      <slot />
    </article>
  </div>
</Base>
