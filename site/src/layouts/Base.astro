---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DILLER, VARSAYILAN, YON, OG_YEREL, cevirmen, yol, type Dil } from '../i18n';
import { SITE_URL } from '../config';

interface Props {
  dil: Dil;
  /** Dil öneki olmayan yol, örn. '/yasal/gizlilik' */
  yalin: string;
  baslik?: string;
  aciklama?: string;
  /** Arama motorlarına kapalı (örn. 404) */
  noindex?: boolean;
}

const { dil, yalin, baslik, aciklama, noindex = false } = Astro.props;
const t = cevirmen(dil);
const siteAdi = t('site.ad');
const tamBaslik = baslik ? `${baslik} | ${siteAdi}` : siteAdi;
const acik = aciklama ?? t('site.aciklama');
const mutlak = (p: string) => new URL(p, SITE_URL).href;
const kanonik = mutlak(yol(dil, yalin));
const ogGorsel = mutlak('/og.png');
---

<!doctype html>
<html lang={dil} dir={YON[dil]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={acik} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={kanonik} />
    {!noindex && DILLER.map((d) => <link rel="alternate" hreflang={d} href={mutlak(yol(d, yalin))} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={mutlak(yol(VARSAYILAN, yalin))} />}
    <meta name="theme-color" content="#235347" />
    <link rel="icon" type="image/png" href="/og.png" />
    <link rel="apple-touch-icon" href="/og.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteAdi} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={acik} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:locale" content={OG_YEREL[dil]} />
    {DILLER.filter((d) => d !== dil).map((d) => <meta property="og:locale:alternate" content={OG_YEREL[d]} />)}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen flex flex-col bg-zemin text-metin antialiased">
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:start-2 focus:z-50 dugme-ana"
      >{t('nav.icerigeGec')}</a
    >
    <Header dil={dil} yalin={yalin} />
    <main id="icerik" class="flex-1">
      <slot />
    </main>
    <Footer dil={dil} />
  </body>
</html>
