rules_version = '2';
// Spark planı: custom claim yok. Rol ve acente, isteği yapanın users/{uid}
// belgesinden okunur (user_type, agency_id). users belgesinin id'si Auth uid'sidir.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Bootstrap: kök süper admin (TC 10000000146). tool/seed.js bu hesapla
    // giriş yapıp ilk verileri (kendi users belgesi dahil) yazar; o anda henüz
    // users belgesi olmadığından rolü e-postadan tanınır. Hesap seed tarafından
    // bir kez oluşturulduktan sonra aynı e-postayla kimse yeniden kayıt olamaz.
    // TODO root uid: kök hesabın uid'si belli olunca e-posta yerine
    // request.auth.uid == '<kök uid>' kullanılmalı (sunucuda config 'root_uid' ile aynı).
    // E-posta eşleşmesi şimdilik seed/bootstrap için korunuyor.
    // Oturumun giriş sağlayıcısı (password / custom / google.com). get(): alan yoksa
    // (ör. bazı custom token'lar) kural hata verip tümden reddetmesin.
    function provider() { return request.auth.token.get('firebase', {}).get('sign_in_provider', ''); }
    // Google ile giriş (bireysel kullanıcı, tool/BIREYSEL_SEMA.md).
    function isGoogle() { return signedIn() && provider() == 'google.com'; }

    // Kök: YALNIZ e-posta/şifre oturumu. Google token'ı aynı e-postayı taşısa bile
    // (umrerehberim.app posta kutusu/alan adı ele geçirilirse doğrulanmış Google hesabı
    // açılabilir) kök sayılmaz; PHP servisinin custom token'ları kök e-postasını taşımaz.
    function isRoot() {
      // get(): e-postası olmayan token'larda kural hata verip tümden reddetmesin.
      return signedIn()
          && !isGoogle()
          && provider() == 'password'
          && request.auth.token.get('email', '') == '10000000146@umrerehberim.app';
    }

    function me()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Rol çözümü. Google token'ı users belgesinde ne yazarsa yazsın 'misafir'dır:
    // e-postayla hesap bağlama (account linking) bir Google oturumuna yönetici/süper admin
    // belgesinin uid'sini verse bile personel yetkisi açılmaz. Tüm rol fonksiyonları
    // (isSuper/isManager/isAgencyAdmin/isSupport/isFinance/isMerchant) role()'den türer.
    function role()   {
      return isRoot() ? 'super_admin' : (isGoogle() ? 'misafir' : me().get('user_type', ''));
    }
    // Genel yöneticinin acentesi olmayabilir; get() ile hata vermez.
    // Google oturumu acentesiz sayılır (bireysel belgelerde zaten ''): bağlanmış bir
    // acente hacısı belgesi Google token'ına acente verisini açmasın.
    function agency() { return isGoogle() ? '' : me().get('agency_id', ''); }
    // Acentesi olan kullanıcı mı? Boş acente ('' = bireysel kullanıcı, platform personeli)
    // HİÇBİR "aynı acente" karşılaştırmasında eşleşmemeli; tüm acente kontrolleri bunu ister.
    function hasAgency() { return agency() != ''; }

    // ROLLER
    //   super_admin  : her şey (acente ekle/sil, anlaşmalı dükkan, esnaf, esnaf raporu)
    //   yonetici     : genel yardımcı admin; TÜM acentelerin verisini yönetir,
    //                  ama dükkan/esnaf/esnaf raporu ve acente ekle/sil YOK
    //   acente_admin : yalnız kendi acentesi (ve oraya kayıtlı kişiler)
    //   esnaf        : yalnız kendi dükkanı
    //   misafir      : kendisi + acentesinin verisi
    function isSuper()       { return signedIn() && role() == 'super_admin'; }
    function isManager()     { return signedIn() && role() == 'yonetici'; }
    function isGlobal()      { return isSuper() || isManager(); }
    function isAgencyAdmin() { return signedIn() && role() == 'acente_admin'; }
    function isAdmin()       { return isGlobal() || isAgencyAdmin(); }
    // Platform personeli (süper adminin açtığı alt hesaplar, acentesi yok):
    //   destek   : acente/kişi okuma, acente mesajları, risk alarmlarını inceleme
    //   muhasebe : esnaf işlemleri, hak ediş, puan hareketleri, kuponlar (okuma) + hak ediş yazma
    function isSupport()     { return signedIn() && role() == 'destek'; }
    function isFinance()     { return signedIn() && role() == 'muhasebe'; }
    // Merkez (acenteye mesaj yazan taraf).
    function isHq()          { return isGlobal() || isSupport(); }
    function isStaff()       { return isAdmin() || isSupport() || isFinance(); }
    // Yazma yetkisi: genel adminler her acente, acente admini yalnız kendi acentesi.
    function sameAgency(d) { return isGlobal() || (isAgencyAdmin() && hasAgency() && d.agency_id == agency()); }
    // Okuma: kendi acentesinin verisi.
    function myAgency(d)   { return signedIn() && hasAgency() && d.agency_id == agency(); }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Esnaf (anlaşmalı dükkan hesabı): users/{uid}.user_type == 'esnaf', shop_id = dükkanı.
    function isMerchant() { return signedIn() && role() == 'esnaf'; }
    function myShop()     { return me().shop_id; }

    // Kullanıcılar:
    // - herkes kendini; genel adminler herkesi; acente admini kendi acentesini görür.
    // - misafir, Rehber İletişim için kendi acentesindeki rehberin (acente_admin/yonetici) belgesini
    //   YALNIZ tek tek (get, id trip_managers'tan) okur; LİSTELEYEMEZ (personelin login_id/user_tc
    //   alanları toplu dökülmesin). Alan bazlı gizleme kurallarla yapılamaz; ayrıntı tool/AUTH_SEMA.md.
    // Oluşturma/düzenleme/silme:
    // - süper admin: her tür
    // - yönetici (genel): misafir ve acente_admin, her acentede
    // - acente admini: yalnız kendi acentesine misafir
    // - esnaf hesabı yalnız süper admin
    function guestOrAgencyAdmin(t) { return t in ['misafir', 'acente_admin']; }
    // Yeni users belgesinde kimlik alanları: auth_migrated ve disabled istemciden yazılamaz;
    // login_id ya yoktur ya da kimlik servisinin login_ids/{id} kaydında BU uid'ye aittir
    // (servis /v1/admin/accounts yanıtından önce yazar). Kural get()'i deny-all belgeyi okuyabilir.
    function newUserAuthFieldsOk(uid) {
      let d = request.resource.data;
      return !d.keys().hasAny(['auth_migrated', 'disabled'])
          && (!('login_id' in d)
              || (d.login_id is string
                  && d.login_id.matches('^[1-9][0-9]{6}$')
                  && get(/databases/$(database)/documents/login_ids/$(d.login_id)).data.uid == uid));
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid
                    || isGlobal() || isSupport() || isFinance()
                    || (isAgencyAdmin() && hasAgency() && resource.data.agency_id == agency())
                    || (myAgency(resource.data) && resource.data.user_type in ['acente_admin', 'yonetici']));
      allow list: if signedIn() && (request.auth.uid == uid
                     || isGlobal() || isSupport() || isFinance()
                     || (isAgencyAdmin() && hasAgency() && resource.data.agency_id == agency()));

      // Bireysel (Google ile giriş) kendi belgesini oluşturur; tool/BIREYSEL_SEMA.md.
      // Yalnız sözleşmedeki alanlar; rol/acente sabit; sunucu zamanı ve doğrulanmış e-posta şart.
      function bireyselCreateOk(uid) {
        let d = request.resource.data;
        let keys = ['user_name', 'user_type', 'account_kind', 'agency_id', 'email', 'auth_provider',
                    'kvkk_version', 'kvkk_accepted_at', 'location_consent', 'created_at', 'updated_at'];
        return request.auth.uid == uid
            && isGoogle()
            && request.auth.token.email_verified == true
            && d.keys().hasOnly(keys)
            && d.keys().hasAll(keys)
            && d.user_name is string && d.user_name.size() >= 2 && d.user_name.size() <= 60
            && d.user_type == 'misafir'
            && d.account_kind == 'bireysel'
            && d.agency_id == ''
            && d.email is string && d.email == request.auth.token.email
            && d.auth_provider == 'google'
            && d.kvkk_version is string && d.kvkk_version.size() >= 1 && d.kvkk_version.size() <= 20
            && d.kvkk_accepted_at == request.time
            && d.location_consent is bool
            && d.created_at == request.time
            && d.updated_at == request.time;
      }
      // Bireysel kendi belgesinde yalnız bu alanları günceller (user_type/account_kind/agency_id sabit).
      function bireyselSelfUpdateOk(uid) {
        let d = request.resource.data;
        return request.auth.uid == uid
            && resource.data.get('account_kind', '') == 'bireysel'
            && changed().hasOnly(['user_name', 'location_consent', 'fcm_token', 'user_location',
                                  'updated_at', 'last_active_at'])
            && (!('user_name' in changed())
                || (d.user_name is string && d.user_name.size() >= 2 && d.user_name.size() <= 60))
            && (!('location_consent' in changed()) || d.location_consent is bool);
      }

      // Not: bireysel dal ilk sırada; users belgesi henüz yokken rol çözümü (me()) hata verir,
      // "||" içinde hata veren dal, diğer dal doğruysa sonucu bozmaz.
      allow create: if bireyselCreateOk(uid)
                    || (newUserAuthFieldsOk(uid)
                        // Yönetici/acente admini bireysel işaretli belge açamaz (yalnız süper admin).
                        && (isSuper() || request.resource.data.get('account_kind', '') != 'bireysel')
                        && (isSuper()
                            || (isManager()
                                && guestOrAgencyAdmin(request.resource.data.user_type)
                                && request.resource.data.agency_id is string
                                && request.resource.data.agency_id != '')
                            || (isAgencyAdmin()
                                && hasAgency()
                                && request.resource.data.agency_id == agency()
                                && request.resource.data.user_type == 'misafir')));

      // 1) Herkes kendi belgesinde yalnızca fcm_token, user_location, updated_at.
      // 2) Kimse (kök hariç) kendi user_type / agency_id / shop_id alanını değiştiremez.
      // 3) login_id ve auth_migrated'ı HİÇ KİMSE değiştiremez (kök dahil): yalnız kimlik servisi
      //    (servis hesabı, kuralları baypas eder) yazar; bkz. tool/AUTH_SEMA.md.
      // 4) Bireysel kendi belgesinde ek olarak user_name ve location_consent'i düzenler.
      // 5) account_kind'ı yalnız süper admin değiştirebilir (yönetici/acente admini çeviremez).
      allow update: if (signedIn() && request.auth.uid == uid
                         && changed().hasOnly(['fcm_token', 'user_location', 'updated_at', 'last_active_at']))
                    || (signedIn() && bireyselSelfUpdateOk(uid))
                    || (!changed().hasAny(['login_id', 'auth_migrated'])
                        && (request.auth.uid != uid || isRoot() || !changed().hasAny(['user_type', 'agency_id', 'shop_id', 'account_kind']))
                        && (isSuper() || !changed().hasAny(['account_kind']))
                        && (isSuper()
                            || (isManager()
                                && guestOrAgencyAdmin(resource.data.user_type)
                                && guestOrAgencyAdmin(request.resource.data.user_type))
                            || (isAgencyAdmin()
                                && hasAgency()
                                && resource.data.agency_id == agency()
                                && resource.data.user_type == 'misafir'
                                && request.resource.data.agency_id == agency()
                                && request.resource.data.user_type == 'misafir')));

      // Bireysel kendi hesabını siler (mağaza şartı); acente hacısı kendini silemez.
      allow delete: if (signedIn() && request.auth.uid == uid
                        && resource.data.get('account_kind', '') == 'bireysel')
                    || isSuper()
                    || (isManager() && guestOrAgencyAdmin(resource.data.user_type))
                    || (isAgencyAdmin() && hasAgency() && resource.data.agency_id == agency()
                        && resource.data.user_type == 'misafir');
    }

    // KİMLİK SERVİSİ (server/umre-api, tool/AUTH_SEMA.md) ---------------------
    // login_ids/{loginId} -> {uid, created_at} ve auth_secrets/{uid} -> {hash, kind, failed,
    // locked_until, ...} YALNIZ PHP servisi tarafından (servis hesabıyla, kuralları baypas
    // ederek) okunur/yazılır. İstemci erişimi yoktur; hash kimseye gösterilmez.
    // (Genel /{col}/{id} kuralı bu koleksiyonları zaten listelemez; yine de açıkça kapalı.)
    // auth_attempts/{hmac}: giriş deneme sayaçları ve (hesap, ağ) kilitleri.
    // system/{doc}: servis durumu (ör. system/auth_migration {done}).
    match /login_ids/{id}     { allow read, write: if false; }
    match /auth_secrets/{id}  { allow read, write: if false; }
    match /auth_attempts/{id} { allow read, write: if false; }
    match /system/{id}        { allow read, write: if false; }

    // Acente ekleme/silme/düzenleme yalnız süper admin.
    match /agencies/{id} {
      allow read: if signedIn() && (isGlobal() || isSupport() || isFinance() || (hasAgency() && agency() == id));
      allow write: if isSuper();
    }

    // Acenteye bağlı koleksiyonlar: aynı acentedeki herkes okur; genel adminler hepsini.
    // Acente admini ve misafirin liste sorguları where('agency_id', isEqualTo: <acente>) içermelidir.
    match /{col}/{id} {
      allow read: if col in ['trips','hotels','rooms','events','currencies','notifications','trip_managers']
                     && (isGlobal() || myAgency(resource.data));
      allow create: if col in ['trips','hotels','rooms','events','currencies','notifications','trip_managers']
                     && sameAgency(request.resource.data);
      allow update: if col in ['trips','hotels','rooms','events','currencies','notifications','trip_managers']
                     && sameAgency(resource.data) && sameAgency(request.resource.data);
      allow delete: if col in ['trips','hotels','rooms','events','currencies','notifications','trip_managers']
                     && sameAgency(resource.data);
    }

    // Telsiz "yayında" durumu: telsiz/{agencyId}_{tripId|all}.
    // Aynı acentedeki herkes okur (liste sorgusu where agency_id == <acente> içermeli),
    // yalnız yönetici/süper admin kendi acentesine yazar. Belge id'si alanlarla tutarlı olmalı.
    match /telsiz/{id} {
      allow read: if isGlobal() || myAgency(resource.data);
      allow create: if sameAgency(request.resource.data)
                    && id == request.resource.data.agency_id + '_' + request.resource.data.trip_id;
      allow update: if sameAgency(resource.data) && sameAgency(request.resource.data)
                    && id == request.resource.data.agency_id + '_' + request.resource.data.trip_id;
      allow delete: if sameAgency(resource.data);
    }

    // Anlaşmalı dükkanlar (shops). agency_id == 'all' ise tüm acentelere açıktır.
    // Liste sorguları ayrı ayrı: where agency_id == <acente> ve where agency_id == 'all'
    // (süper admin filtresiz okuyabilir). Pasif (is_active == false) dükkanları istemci gizler.
    match /shops/{id} {
      allow read: if signedIn()
                  && (resource.data.agency_id == 'all' || isSuper() || isFinance() || myAgency(resource.data)
                      || (isMerchant() && myShop() == id));
      // Anlaşmalı dükkanları YALNIZ süper admin yönetir (yönetici ve acente admini değil).
      allow create: if isSuper();
      // Esnaf kendi dükkanının yalnız vitrin alanlarını düzenleyebilir
      // (indirim, komisyon, acente, aktiflik süper adminde kalır).
      allow update: if isSuper()
                    || (isMerchant() && myShop() == id
                        && changed().hasOnly(['description', 'working_hours', 'phone',
                                              'whatsapp', 'logo_base64', 'updated_at']))
                    // Tıklanma sayacı: dükkanı görebilen herkes yalnız view_count'u 1 artırır.
                    || (signedIn()
                        && (resource.data.agency_id == 'all' || myAgency(resource.data))
                        && changed().hasOnly(['view_count'])
                        && request.resource.data.view_count == resource.data.get('view_count', 0) + 1);
      allow delete: if isSuper();
    }

    // ESNAF PANELİ ------------------------------------------------------------
    // Misafirin esnafa gösterdiği tek kullanımlık QR kodu. Belge id'si rastgele;
    // QR yalnız "UMRE1:<id>" içerir. Esnaf id ile tek belge okur (liste yok).
    match /shop_tokens/{id} {
      allow create: if signedIn()
                    && request.resource.data.guest_uid == request.auth.uid
                    && ((hasAgency() && request.resource.data.agency_id == agency())
                        || (paidBireysel() && request.resource.data.agency_id == ''))
                    && request.resource.data.created_at == request.time
                    && request.resource.data.used == false
                    && request.resource.data.points_available is int
                    && request.resource.data.points_available >= 0;
      allow get: if signedIn() && (resource.data.guest_uid == request.auth.uid || isMerchant());
      allow list: if signedIn() && resource.data.guest_uid == request.auth.uid;
      // Esnaf kodu yalnız aynı batch'te işlem kaydını açarken "kullanıldı" yapar.
      allow update: if isMerchant()
                    && resource.data.used == false
                    && changed().hasOnly(['used', 'used_by_shop', 'used_by_shop_name', 'used_at'])
                    && request.resource.data.used == true
                    && request.resource.data.used_by_shop == myShop()
                    && existsAfter(/databases/$(database)/documents/shop_transactions/$(id));
      allow delete: if signedIn() && resource.data.guest_uid == request.auth.uid;
    }

    // Esnaftaki alışveriş kaydı. Belge id'si = kod id'si, bu yüzden bir kod
    // en fazla bir işlemde kullanılır. Uygulama ödeme TAHSİL ETMEZ; esnaf kaydeder.
    match /shop_transactions/{id} {
      function tok()  { return get(/databases/$(database)/documents/shop_tokens/$(id)).data; }
      function shop() { return get(/databases/$(database)/documents/shops/$(myShop())).data; }

      allow create: if isMerchant()
                    && exists(/databases/$(database)/documents/shop_tokens/$(id))
                    && request.resource.data.shop_id == myShop()
                    && request.resource.data.cashier_uid == request.auth.uid
                    && request.resource.data.status == 'ok'
                    && request.resource.data.created_at == request.time
                    // kod: kullanılmamış, 3 dakikadan yeni, aynı misafir
                    && tok().used == false
                    && tok().created_at > request.time - duration.value(3, 'm')
                    && tok().guest_uid == request.resource.data.guest_uid
                    && tok().agency_id == request.resource.data.guest_agency_id
                    // dükkan: aktif, misafirin acentesine açık; oranlar dükkandan
                    && shop().is_active != false
                    && (shop().agency_id == 'all' || (tok().agency_id != '' && shop().agency_id == tok().agency_id))
                    && request.resource.data.shop_agency_id == shop().agency_id
                    && request.resource.data.discount_percent == shop().discount_percent
                    && request.resource.data.commission_percent == shop().get('commission_percent', 0)
                    // tutarlar
                    && request.resource.data.payment_method in ['nakit', 'kart', 'puan']
                    && request.resource.data.amount_gross is number
                    && request.resource.data.amount_gross > 0
                    && request.resource.data.amount_gross <= 20000
                    && request.resource.data.amount_net >= 0
                    && request.resource.data.amount_net <= request.resource.data.amount_gross
                    && request.resource.data.points_spent is int
                    && request.resource.data.points_spent >= 0
                    && request.resource.data.points_spent <= tok().points_available
                    && request.resource.data.points_earned is int
                    && request.resource.data.points_earned >= 0
                    && request.resource.data.points_earned <= request.resource.data.amount_net + 1
                    // kupon: misafirin QR'da seçtiğiyle aynı olmalı
                    && request.resource.data.get('coupon_id', '') == tok().get('coupon_id', '')
                    && ((request.resource.data.get('coupon_id', '') == ''
                         && request.resource.data.get('coupon_discount', 0) == 0)
                        || couponOk(request.resource.data));

      // Kupon geçerliliği: aktif, tarih aralığında, acente/dükkan uygun, alt limit,
      // kullanım sınırı, indirim tavanı; aynı batch'te misafir başına tek kullanım kaydı.
      function couponOk(d) {
        let c = get(/databases/$(database)/documents/coupons/$(d.coupon_id)).data;
        let cap = c.type == 'percent' ? d.amount_gross * c.value / 100 : c.value;
        return c.active == true
            && request.time >= c.valid_from && request.time <= c.valid_until
            && (c.agency_id == 'all' || (d.guest_agency_id != '' && c.agency_id == d.guest_agency_id))
            && (c.shop_id == 'all' || c.shop_id == d.shop_id)
            && d.amount_gross >= c.min_spend
            && (c.max_uses == 0 || c.used_count < c.max_uses)
            && d.coupon_discount is number
            && d.coupon_discount > 0
            && d.coupon_discount <= cap + 0.01
            && (c.max_discount == 0 || d.coupon_discount <= c.max_discount + 0.01)
            && existsAfter(/databases/$(database)/documents/coupon_redemptions/$(d.coupon_id + '_' + d.guest_uid));
      }

      // Esnaf raporları: süper admin ve muhasebe; misafir kendi, esnaf kendi dükkanı.
      allow read: if signedIn()
                  && (resource.data.guest_uid == request.auth.uid
                      || (isMerchant() && resource.data.shop_id == myShop())
                      || isSuper() || isFinance());

      // İptal: kayıt silinmez, işaretlenir. Esnaf 24 saat içinde; süper admin her zaman.
      allow update: if resource.data.status == 'ok'
                    && changed().hasOnly(['status', 'cancel_reason', 'cancelled_at'])
                    && request.resource.data.status == 'iptal'
                    && ((isMerchant() && resource.data.shop_id == myShop()
                         && request.time < resource.data.created_at + duration.value(24, 'h'))
                        || isSuper());
      allow delete: if false;
    }

    // SÜPER ADMİN MODÜLLERİ ---------------------------------------------------
    // Şema: tool/SUPER_ADMIN_SEMA.md

    // Denetim kaydı: yöneticiler yalnız kendi adına ekler; kimse değiştiremez/silemez.
    match /audit_logs/{id} {
      allow create: if isStaff()
                    && request.resource.data.actor_uid == request.auth.uid
                    && request.resource.data.created_at == request.time
                    && request.resource.data.action is string;
      allow read: if isSuper();
      allow update, delete: if false;
    }

    // Elle puan hareketi (+/-). Bakiye = alışveriş puanları + bu kayıtların toplamı.
    // Geri alma: ters işaretli yeni kayıt + asıl kayıtta reverted=true.
    match /point_adjustments/{id} {
      allow create: if isSuper()
                    && request.resource.data.created_by == request.auth.uid
                    && request.resource.data.created_at == request.time
                    && request.resource.data.points is int
                    && request.resource.data.points != 0
                    && request.resource.data.points >= -100000
                    && request.resource.data.points <= 100000
                    && request.resource.data.guest_uid is string;
      allow update: if isSuper()
                    && changed().hasOnly(['reverted', 'reverted_by_id', 'reverted_at'])
                    && resource.data.get('reverted', false) == false;
      allow read: if signedIn()
                  && (resource.data.guest_uid == request.auth.uid || isSuper() || isFinance());
      allow delete: if false;
    }

    // Kuponlar (belge id = kod, büyük harf). Misafir aktif ve acentesine uygun olanları görür
    // (sorgu where active == true + where agency_id in ['all', <acente>] içermeli).
    match /coupons/{id} {
      allow read: if signedIn()
                  && (isSuper() || isFinance() || isMerchant()
                      || (resource.data.active == true
                          && (resource.data.agency_id == 'all' || (hasAgency() && resource.data.agency_id == agency()))));
      allow create, delete: if isSuper();
      allow update: if isSuper()
                    // Esnaf yalnız işlem kaydıyla aynı batch'te kullanım sayısını 1 artırır.
                    || (isMerchant()
                        && changed().hasOnly(['used_count', 'last_tx_id'])
                        && request.resource.data.used_count == resource.data.used_count + 1
                        && !exists(/databases/$(database)/documents/shop_transactions/$(request.resource.data.last_tx_id))
                        && getAfter(/databases/$(database)/documents/shop_transactions/$(request.resource.data.last_tx_id)).data.coupon_id == id);
    }

    // Kupon kullanımı: id = <kupon>_<misafirUid> → misafir başına tek kullanım.
    match /coupon_redemptions/{id} {
      allow create: if isMerchant()
                    && id == request.resource.data.coupon_id + '_' + request.resource.data.guest_uid
                    && !exists(/databases/$(database)/documents/shop_transactions/$(request.resource.data.tx_id))
                    && getAfter(/databases/$(database)/documents/shop_transactions/$(request.resource.data.tx_id)).data.coupon_id == request.resource.data.coupon_id
                    && getAfter(/databases/$(database)/documents/shop_transactions/$(request.resource.data.tx_id)).data.guest_uid == request.resource.data.guest_uid;
      allow read: if signedIn()
                  && (resource.data.guest_uid == request.auth.uid || isSuper() || isFinance());
      allow update, delete: if false;
    }

    // Değerlendirme/şikâyet: id = işlem id'si; yalnız o alışverişi yapan misafir, bir kez.
    match /shop_reviews/{txId} {
      function rtx() { return get(/databases/$(database)/documents/shop_transactions/$(txId)).data; }
      allow create: if signedIn()
                    && rtx().guest_uid == request.auth.uid
                    && rtx().status == 'ok'
                    && request.resource.data.guest_uid == request.auth.uid
                    && request.resource.data.shop_id == rtx().shop_id
                    && request.resource.data.guest_agency_id == rtx().guest_agency_id
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.get('comment', '').size() <= 500
                    && request.resource.data.created_at == request.time;
      allow read: if signedIn()
                  && (resource.data.guest_uid == request.auth.uid || isSuper() || isFinance()
                      || (isMerchant() && resource.data.shop_id == myShop()));
      allow update: if false;
      allow delete: if isSuper();
    }

    // Hak ediş dönemleri (id = <shopId>_<YYYY-MM>) ve finans ayarları.
    match /settlements/{id} {
      allow read, write: if isSuper() || isFinance();
    }
    match /platform_settings/{id} {
      allow read: if isSuper() || isFinance();
      allow write: if isSuper();
    }

    // BİREYSEL PAKET HAKKI (tool/BIREYSEL_SEMA.md "Paketler") ------------------
    // entitlements/{uid}: { paket: umre|aile|full, status: active|pending_approval,
    //   paid_until: timestamp, source, updated_at }.
    // Gerçek ödemede (PayTR) YALNIZ sunucu yazar. Demo döneminde
    // platform_settings/payments.demo_payments == true iken bireysel kendi hakkını yazar
    // (ödeme alınmaz); süper admin anahtarı kapatınca bu yol kapanır.
    // Full paket "pending_approval" ile açılır; süper admin onaylayıp "active" yapar.
    function demoPayments() {
      return get(/databases/$(database)/documents/platform_settings/payments).data.get('demo_payments', false) == true;
    }
    function paidBireysel() {
      let e = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return isGoogle() && agency() == '' && exists(e)
          && get(e).data.status == 'active'
          && get(e).data.paid_until > request.time;
    }
    match /entitlements/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow create, update: if isSuper()
                    || (request.auth.uid == uid && isGoogle() && demoPayments()
                        && request.resource.data.keys().hasOnly(['paket', 'status', 'paid_until', 'source', 'updated_at'])
                        && request.resource.data.source == 'demo'
                        && request.resource.data.updated_at == request.time
                        && request.resource.data.paid_until is timestamp
                        && request.resource.data.paid_until > request.time
                        && request.resource.data.paid_until <= request.time + duration.value(31, 'd')
                        && ((request.resource.data.paket in ['umre', 'aile'] && request.resource.data.status == 'active')
                            || (request.resource.data.paket == 'full' && request.resource.data.status == 'pending_approval')));
      allow delete: if isSuper() || (request.auth.uid == uid && isGoogle() && demoPayments());
    }

    // Risk alarmı incelemeleri (alarm id'si istemcide üretilir).
    match /risk_reviews/{id} {
      allow read, write: if isSuper() || isSupport();
    }

    // Merkez ↔ acente mesajları. Merkez: süper admin, yönetici, destek.
    // Acente admini yalnız kendi acentesinin mesajlarını görür
    // (sorgu where agency_id == <acente> içermeli) ve yalnız 'agency' tarafı olarak yazar.
    match /agency_messages/{id} {
      allow read: if isHq() || (isAgencyAdmin() && hasAgency() && resource.data.agency_id == agency());
      allow create: if request.resource.data.from_uid == request.auth.uid
                    && request.resource.data.created_at == request.time
                    && ((isHq() && request.resource.data.from_side == 'hq')
                        || (isAgencyAdmin() && hasAgency() && request.resource.data.from_side == 'agency'
                            && request.resource.data.agency_id == agency()));
      allow update: if (isHq() && changed().hasOnly(['read_by_hq']))
                    || (isAgencyAdmin() && hasAgency() && resource.data.agency_id == agency()
                        && changed().hasOnly(['read_by_agency']));
      allow delete: if isSuper();
    }

    // TOPLU HATİM -------------------------------------------------------------
    // Şema ve işlemler: tool/HATIM_SEMA.md. Sunucu kodu yok; sayaç bütünlüğü
    // (bir parça bir kez sayılır) ve kota (holds) parça belgesi + grup güncellemesinin
    // aynı batch'te get()/getAfter() ile çapraz doğrulanmasına dayanır.
    //
    // Maliyet notu: grup update kuralı önce ucuz alanlarla (changed() ve
    // last_event.type) TEK bir dala yönlenir; get()/getAfter() yalnız o dalda,
    // en sonda çalışır. Böylece reddedilen isteklerde de tüm dallar değerlendirilmez
    // (1000 ifade sınırı) ve istek başına belge okuma sayısı küçük kalır.

    // Grup oluşturma hız sınırı: kullanıcı başına bir belge, son oluşturma zamanı.
    // Grup, bu belgeyle aynı batch'te ve en az 60 sn arayla oluşturulabilir.
    match /hatim_rate/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last_create_at'])
        && request.resource.data.last_create_at == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last_create_at'])
        && request.resource.data.last_create_at == request.time
        && request.time > resource.data.last_create_at + duration.value(60, 's');
      allow delete: if false;
    }

    match /hatim_groups/{gid} {
      function hgOld() { return resource.data; }
      function hgNew() { return request.resource.data; }
      // Okuma: herkese açık, aynı acente, üye, genel admin veya destek.
      // (acente_admin ve muhasebe başka acentenin özel grubunu OKUYAMAZ.)
      function hgCanRead(d) {
        return d.is_public == true
            || (agency() != '' && d.agency_id == agency())
            || request.auth.uid in d.members
            || isGlobal()
            || isSupport();
      }
      // last_event: yalnız bilinen anahtarlar; kimlik ve zaman sunucudan doğrulanır.
      // unit her olayda tamsayı ve 0..604 (büyük metin yazılamaz).
      function hgEvent(kind) {
        let e = hgNew().last_event;
        return e is map
            && e.keys().hasOnly(['type', 'uid', 'name', 'unit', 'round', 'at'])
            && e.type == kind
            && e.uid == request.auth.uid
            && e.at == request.time
            && e.get('unit', 0) is int
            && e.get('unit', 0) >= 0
            && e.get('unit', 0) <= 604
            && e.get('round', hgNew().round) == hgNew().round
            && hgNew().updated_at == request.time
            && e.name == me().user_name;
      }
      function hgPartPath(round, n) {
        return /databases/$(database)/documents/hatim_groups/$(gid)/parts/$(string(round) + '_' + string(n));
      }
      function hgNameOk(v)  { return v is string && v.size() >= 3 && v.size() <= 60; }
      function hgNiyetOk(v) { return v is string && v.size() <= 300; }
      function hgDeadlineOk(v) { return v == null || v is timestamp; }

      // Kota: holds = { uid: o an 'taken' durumundaki parça sayısı }.
      function hgHolds(d)   { return d.get('holds', {}); }
      function hgHoldsDiff() { return hgHolds(hgNew()).diff(hgHolds(hgOld())).affectedKeys(); }
      function hgDec(n)     { return n > 0 ? n - 1 : 0; }
      function hgCap()      { return hgOld().unit == 'cuz' ? 3 : 20; }
      // Parça olaylarında unit = parça numarası (1..total).
      function hgUnitOk() {
        let u = hgNew().last_event.get('unit', null);
        return u is int && u >= 1 && u <= hgOld().total;
      }

      allow get, list: if signedIn() && hgCanRead(resource.data);

      allow create: if signedIn()
        && hgNew().keys().hasOnly(['name', 'niyet', 'unit', 'total', 'is_public', 'agency_id', 'owner_uid',
                                   'owner_name', 'members', 'member_count', 'round', 'done_count', 'status',
                                   'holds', 'deadline', 'last_event', 'created_at', 'updated_at'])
        && hgNew().keys().hasAll(['name', 'unit', 'total', 'is_public', 'agency_id', 'owner_uid', 'owner_name',
                                  'members', 'member_count', 'round', 'done_count', 'status', 'holds',
                                  'last_event', 'created_at', 'updated_at'])
        && hgNew().owner_uid == request.auth.uid
        && hgNew().members is list
        && hgNew().members == [request.auth.uid]
        && hgNew().member_count is int && hgNew().member_count == 1
        && hgNew().round is int && hgNew().round == 1
        && hgNew().done_count is int && hgNew().done_count == 0
        && hgNew().status == 'active'
        && hgNew().holds is map && hgNew().holds.size() == 0
        && ((hgNew().unit == 'cuz' && hgNew().total is int && hgNew().total == 30)
            || (hgNew().unit == 'sayfa' && hgNew().total is int && hgNew().total == 604))
        && hgNameOk(hgNew().name)
        && hgNiyetOk(hgNew().get('niyet', ''))
        && hgNew().is_public is bool
        && hgDeadlineOk(hgNew().get('deadline', null))
        && hgNew().created_at == request.time
        && hgEvent('create')
        && role() != 'esnaf'
        && hgNew().agency_id is string && hgNew().agency_id == agency()
        && hgNew().owner_name == me().user_name
        // Hız sınırı: aynı batch'te hatim_rate/{ben} = request.time yazılmış olmalı.
        && getAfter(/databases/$(database)/documents/hatim_rate/$(request.auth.uid)).data.last_create_at == request.time;

      // --- update dalları (her biri yalnız dispatcher seçtiğinde çalışır) ---

      // Düzenle: yalnız sahip, yalnız vitrin alanları.
      function hgEditOk() {
        return hgOld().owner_uid == request.auth.uid
          && hgNameOk(hgNew().name)
          && hgNiyetOk(hgNew().get('niyet', ''))
          && hgNew().is_public is bool
          && hgDeadlineOk(hgNew().get('deadline', null))
          && hgNew().updated_at == request.time;
      }

      // Katıl kendi ayrılışının hemen ardından ise 30 sn beklenir (bildirim spam'i).
      function hgRejoinOk() {
        let le = hgOld().get('last_event', {});
        return !(le.get('type', '') == 'leave' && le.get('uid', '') == request.auth.uid)
            || request.time > le.at + duration.value(30, 's');
      }

      // Katıl: yalnız kendi uid'si eklenir.
      function hgJoinOk() {
        return changed().hasOnly(['members', 'member_count', 'last_event', 'updated_at'])
          && hgNew().members is list
          && !(request.auth.uid in hgOld().members)
          && hgNew().members.size() == hgOld().members.size() + 1
          && hgNew().members.size() <= 200
          && hgNew().members.hasAll(hgOld().members)
          && request.auth.uid in hgNew().members
          && hgNew().member_count is int
          && hgNew().member_count == hgNew().members.size()
          && hgRejoinOk()
          && hgEvent('join')
          && (hgOld().is_public == true || (agency() != '' && hgOld().agency_id == agency()));
      }

      // Ayrıl: yalnız kendi uid'si çıkar; sahip ayrılamaz. holds dokunulmaz
      // (geri dönerse kotası aynı kalır).
      function hgLeaveOk() {
        return changed().hasOnly(['members', 'member_count', 'last_event', 'updated_at'])
          && hgNew().members is list
          && request.auth.uid in hgOld().members
          && request.auth.uid != hgOld().owner_uid
          && !(request.auth.uid in hgNew().members)
          && hgNew().members.size() == hgOld().members.size() - 1
          && hgOld().members.hasAll(hgNew().members)
          && hgNew().member_count is int
          && hgNew().member_count == hgNew().members.size()
          && hgEvent('leave');
      }

      // Üyeyi çıkar: sahip (veya genel admin) tam olarak bir üyeyi (sahip değil) çıkarır;
      // o üyenin holds anahtarı silinir. Parçalarını sahip önceden 'release' ile boşaltır.
      function hgKickOk() {
        let gone = hgOld().members.removeAll(hgNew().members);
        return changed().hasOnly(['members', 'member_count', 'holds', 'last_event', 'updated_at'])
          && hgNew().members is list
          && hgNew().members.size() == hgOld().members.size() - 1
          && hgOld().members.hasAll(hgNew().members)
          && gone.size() == 1
          && gone[0] != hgOld().owner_uid
          && hgNew().member_count is int
          && hgNew().member_count == hgNew().members.size()
          && !(gone[0] in hgHolds(hgNew()))
          && hgHoldsDiff().hasOnly([gone[0]])
          && hgNew().last_event.get('unit', 0) == 0
          && (hgOld().owner_uid == request.auth.uid || isGlobal())
          && hgEvent('kick');
      }

      // Parça al: parça (batch öncesi yok) aynı batch'te benim adıma 'taken' oluşur,
      // holds[ben] +1 ve kota (cüz 3 / sayfa 20) aşılmaz.
      function hgTakePartOk(path) {
        return !exists(path)
          && getAfter(path).data.uid == request.auth.uid
          && getAfter(path).data.status == 'taken';
      }
      function hgTakeOk() {
        return changed().hasOnly(['holds', 'last_event', 'updated_at'])
          && hgOld().status == 'active'
          && request.auth.uid in hgOld().members
          && hgUnitOk()
          && hgHoldsDiff().hasOnly([request.auth.uid])
          && hgHolds(hgNew()).get(request.auth.uid, 0) is int
          && hgHolds(hgNew()).get(request.auth.uid, 0) == hgHolds(hgOld()).get(request.auth.uid, 0) + 1
          && hgHolds(hgNew()).get(request.auth.uid, 0) <= hgCap()
          && hgEvent('take')
          && hgTakePartOk(hgPartPath(hgOld().round, hgNew().last_event.unit));
      }

      // Parça bırak: parça batch öncesi var ve 'taken', batch sonrası yok; yapan parça
      // sahibi, grup sahibi veya genel admin; holds[parça sahibi] −1.
      function hgReleasePartOk(path) {
        let p = get(path).data;
        return p.status == 'taken'
          && !existsAfter(path)
          && hgHoldsDiff().hasOnly([p.uid])
          && hgHolds(hgNew()).get(p.uid, 0) == hgDec(hgHolds(hgOld()).get(p.uid, 0))
          && (p.uid == request.auth.uid || hgOld().owner_uid == request.auth.uid || isGlobal());
      }
      function hgReleaseOk() {
        return changed().hasOnly(['holds', 'last_event', 'updated_at'])
          && hgOld().status == 'active'
          && hgUnitOk()
          && hgEvent('release')
          && exists(hgPartPath(hgOld().round, hgNew().last_event.unit))
          && hgReleasePartOk(hgPartPath(hgOld().round, hgNew().last_event.unit));
      }

      // Bitirdim: parça taken→done ile aynı batch'te sayaç +1, holds[ben] −1.
      // Parça batch öncesi 'taken', bende ve en az 60 sn önce alınmış; batch sonrası 'done'.
      function hgDonePartOk(path) {
        let b = get(path).data;
        let a = getAfter(path).data;
        return b.status == 'taken'
          && b.uid == request.auth.uid
          && request.time > b.taken_at + duration.value(60, 's')
          && a.status == 'done'
          && a.uid == request.auth.uid;
      }
      function hgDoneOk() {
        return changed().hasOnly(['done_count', 'holds', 'status', 'completed_at', 'last_event', 'updated_at'])
          && hgOld().status == 'active'
          && request.auth.uid in hgOld().members
          && hgNew().done_count is int
          && hgNew().done_count == hgOld().done_count + 1
          && hgNew().done_count <= hgOld().total
          && hgUnitOk()
          && hgHoldsDiff().hasOnly([request.auth.uid])
          && hgHolds(hgNew()).get(request.auth.uid, 0) == hgDec(hgHolds(hgOld()).get(request.auth.uid, 0))
          && (hgNew().done_count == hgOld().total
              ? (hgNew().status == 'completed'
                 && hgNew().completed_at == request.time
                 && hgEvent('completed'))
              : (!changed().hasAny(['status', 'completed_at'])
                 && hgEvent('done')))
          && hgDonePartOk(hgPartPath(hgOld().round, hgNew().last_event.unit));
      }

      // Yeni tur: yalnız sahip (veya genel admin), tamamlanmış grupta; holds sıfırlanır.
      function hgNewRoundOk() {
        return changed().hasOnly(['round', 'done_count', 'status', 'completed_at', 'holds', 'last_event', 'updated_at'])
          && hgOld().status == 'completed'
          && hgNew().round is int
          && hgNew().round == hgOld().round + 1
          && hgNew().done_count is int && hgNew().done_count == 0
          && hgNew().status == 'active'
          && hgNew().get('completed_at', null) == null
          && hgHolds(hgNew()) is map && hgHolds(hgNew()).size() == 0
          && (hgOld().owner_uid == request.auth.uid || isGlobal())
          && hgEvent('new_round');
      }

      // Olay tipine göre tek dal (ucuz seçim).
      function hgByType(t) {
        return t == 'join' ? hgJoinOk()
          : (t == 'leave' ? hgLeaveOk()
          : (t == 'take' ? hgTakeOk()
          : (t == 'release' ? hgReleaseOk()
          : ((t == 'done' || t == 'completed') ? hgDoneOk()
          : (t == 'kick' ? hgKickOk()
          : (t == 'new_round' ? hgNewRoundOk()
          : false))))));
      }
      function hgUpdateOk() {
        let c = changed();
        return c.hasOnly(['name', 'niyet', 'deadline', 'is_public', 'updated_at'])
          ? hgEditOk()
          : (c.hasAny(['last_event']) && hgNew().last_event is map
              ? hgByType(hgNew().last_event.get('type', ''))
              : false);
      }

      allow update: if signedIn() && hgUpdateOk();

      // Not: alt koleksiyon (parts) belgeleri grup silinince otomatik silinmez; istemci
      // önce bırakılabilir parçaları siler. Bitmiş parçalar yalnız grup silindikten
      // sonra (sahipsiz) süper admince silinir.
      allow delete: if signedIn()
        && (hgOld().owner_uid == request.auth.uid
            || isGlobal()
            || (isAgencyAdmin() && hgOld().agency_id != '' && hgOld().agency_id == agency()));

      match /parts/{pid} {
        function pgPath() { return /databases/$(database)/documents/hatim_groups/$(gid); }
        function pg()  { return get(pgPath()).data; }
        function pga() { return getAfter(pgPath()).data; }
        function pNew() { return request.resource.data; }

        // Sahipsiz (grubu silinmiş) parçalar temizlik için süper admince okunur.
        allow get, list: if signedIn() && (hgCanRead(pg()) || isSuper());

        // Parça al: belge id'si '<tur>_<n>' tekil olduğundan aynı parça iki kişiye verilmez.
        // Aynı batch'te grup: last_event take (unit = n) ve holds[ben] = eski + 1.
        // (Tek grup güncellemesi tek parçaya bağlanır; iki parça tek +1 ile alınamaz.)
        function pTakeBound() {
          let a = pga();
          return a.last_event.type == 'take'
            && a.last_event.unit == pNew().n
            && a.round == pNew().round
            && a.get('holds', {}).get(request.auth.uid, -1) == pg().get('holds', {}).get(request.auth.uid, 0) + 1;
        }
        allow create: if signedIn()
          && pNew().keys().hasOnly(['n', 'round', 'uid', 'name', 'status', 'taken_at', 'done_at'])
          && pNew().keys().hasAll(['n', 'round', 'uid', 'name', 'status', 'taken_at', 'done_at'])
          && pNew().uid == request.auth.uid
          && pNew().status == 'taken'
          && pNew().taken_at == request.time
          && pNew().done_at == null
          && pNew().n is int
          && pNew().round is int
          && pid == string(pNew().round) + '_' + string(pNew().n)
          && pg().status == 'active'
          && request.auth.uid in pg().members
          && pNew().n >= 1 && pNew().n <= pg().total
          && pNew().round == pg().round
          && pNew().name == me().user_name
          && pTakeBound();

        // Bitirdim: yalnız parça sahibi, taken→done, alındıktan en az 60 sn sonra.
        // Aynı batch'te grup sayacı +1 VE grubun last_event'i tam bu parçayı gösterir.
        function pDoneBound() {
          let a = pga();
          return a.last_event.type in ['done', 'completed']
            && a.last_event.unit == resource.data.n
            && a.round == resource.data.round
            && a.done_count == pg().done_count + 1;
        }
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'taken'
          && changed().hasOnly(['status', 'done_at'])
          && pNew().status == 'done'
          && pNew().done_at == request.time
          && request.time > resource.data.taken_at + duration.value(60, 's')
          && pDoneBound();

        // Bırak: yalnız 'taken' parça; sahibi, grup sahibi veya genel admin.
        // Bitmiş parça kimse tarafından silinemez (yeniden alınıp iki kez sayılmasın);
        // yalnız grup silindikten sonra sahipsiz kalan parçayı süper admin temizler.
        allow delete: if signedIn() && (
          (resource.data.status == 'taken'
            && (resource.data.uid == request.auth.uid
                || pg().owner_uid == request.auth.uid
                || isGlobal()))
          || (isSuper() && !exists(pgPath())));
      }
    }

    // Ezan vakitleri (orijinal koleksiyon adları): herkes okur, süper admin yazar.
    match /mekke_prayer_times/{id}  { allow read: if true; allow write: if isSuper(); }
    match /medine_prayer_times/{id} { allow read: if true; allow write: if isSuper(); }

    // Dualar vb. ortak içerik
    match /content/{doc=**} {
      allow read: if signedIn();
      allow write: if isSuper();
    }
  }
}
