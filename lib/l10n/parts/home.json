  "homeDuaQuoteNear": {
    "tr": "Kullarım sana beni sorarlarsa, bilsinler ki ben onlara çok yakınım. Bana dua edince, dua edenin duasına cevap veririm.",
    "en": "And when My servants ask you concerning Me – indeed I am near. I respond to the invocation of the supplicant when he calls upon Me.",
    "ar": "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ"
  },
  "homeDuaQuoteCallUpon": {
    "tr": "Rabbiniz şöyle dedi: Bana dua edin, size karşılık vereyim.",
    "en": "And your Lord says, \"Call upon Me; I will respond to you.\"",
    "ar": "وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ"
  },
  "homeDuaQuoteHearts": {
    "tr": "Bilesiniz ki kalpler ancak Allah'ı anmakla huzur bulur.",
    "en": "Unquestionably, by the remembrance of Allah hearts are assured.",
    "ar": "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ"
  },
  "homeDuaQuoteRemember": {
    "tr": "Öyleyse yalnız beni anın ki ben de sizi anayım.",
    "en": "So remember Me; I will remember you.",
    "ar": "فَاذْكُرُونِي أَذْكُرْكُمْ"
  },
